#!/bin/bash
#
#SBATCH --job-name=taelwfm-{{id}}    # Job name for tracking
#SBATCH --partition={{partition}}  # Partition you wish to use (see above for list)
#SBATCH --cpus-per-task={{cpus_per_task}}        # Number of CPU threads used by your job
#SBATCH --ntasks=1
#SBATCH --gres=gpu:{{gpus}}              # Number of GPUs to use 
#SBATCH --time=2-00:00:00         # Job time limit set to 2 days (48 hours)
#
#SBATCH --mail-type=END,FAIL,TIME_LIMIT_80 # Events to send email on, remove if you don't want this
#SBATCH --output=joboutput_%j.out # Standard out from your job
#SBATCH --error=joboutput_%j.err  # Standard error from your job

## Initialisation ##
source /etc/profile.d/modules.sh
source /etc/profile.d/conda.sh

## Execute your program(s) ##
module load CUDA

export PATH="$HOME/.local/bin:$PATH"
python3.14 -m pip install --user {{largepath}}
cd {{largepath}}
python3.14 -m lwfm.run --config {{experiment}}